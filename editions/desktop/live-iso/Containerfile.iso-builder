# Arch "ISO builder" image, run from the Fedora host via podman. Gives us
# `mkarchiso` (archiso) to build the DraftOS Desktop live ISO, plus the Rust +
# libcosmic toolchain to compile the installer and engine against the same
# libraries the live COSMIC environment ships.
#
# No custom keyring bootstrap is needed: the Desktop edition installs a stock
# Arch base with our own engine (no arkdep), so only the official repos are used.

FROM docker.io/library/archlinux:latest

# Reliable mirrors + no download-timeout: the default image mirror occasionally
# stalls ("Operation too slow"), which aborts the build. A curated mirrorlist and
# --disable-download-timeout let slow-but-progressing fetches succeed.
RUN printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\nServer = https://mirror.rackspace.com/archlinux/$repo/os/$arch\nServer = https://mirrors.kernel.org/archlinux/$repo/os/$arch\n' \
        > /etc/pacman.d/mirrorlist

RUN pacman -Syu --noconfirm --needed --disable-download-timeout \
        archiso \
        base-devel git \
        arch-install-scripts \
        btrfs-progs dosfstools \
        squashfs-tools \
        zstd \
        reflector \
        # Rust + libcosmic build deps (to compile draftos-installer + engine) --
        rust cargo pkgconf cmake clang \
        libxkbcommon wayland mesa vulkan-icd-loader \
        fontconfig freetype2 expat \
 && pacman -Scc --noconfirm

# Regenerate a fresh, fast mirrorlist (mkarchiso's pacstrap uses this via the
# profile's pacman.conf). Falls back to the bootstrap list above if offline.
RUN reflector --protocol https --age 12 --latest 20 --sort score \
        --save /etc/pacman.d/mirrorlist || true

WORKDIR /iso
